rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // username -> uid. Merret vetëm një herë, s'mund të ndryshohet më pas.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Profili i lojtarit: e lexojnë të gjithë të kyçurit, e shkruan vetëm pronari.
    match /players/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Shënim: 'games' (lëvizjet live të lojës) nuk jeton ma këtu — u kalue te Firebase
    // Realtime Database (ma e shpejtë për sinkronizim të vogël mes 2 lojtarësh).
    // Rregullat e tij jan te databaza konsola → Realtime Database → Rules.
  }
}
