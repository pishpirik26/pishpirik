rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // username -> uid. Merret vetëm një herë, s'mund të ndryshohet më pas.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Profili i lojtarit: e lexojnë të gjithë të kyçurit, e shkruan vetëm pronari.
    match /players/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Lojërat: vetëm lojtarët e lojës mund ta lexojnë dhe ta ndryshojnë.
    match /games/{gameId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.p);
      // Pishpirik: 2 lojtarë; Lojë me gurë: deri në 4 (vendet e lira i zë CPU-ja)
      allow create: if signedIn()
        && request.resource.data.p.size() >= 2
        && request.resource.data.p.size() <= 4
        && request.resource.data.p[0] == request.auth.uid
        && !(request.auth.uid in request.resource.data.p[1:]);
      allow update: if signedIn()
        && request.auth.uid in resource.data.p
        && request.resource.data.p == resource.data.p;
      allow delete: if signedIn() && request.auth.uid in resource.data.p;
    }
  }
}
